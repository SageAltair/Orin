{
  "version": 1,
  "namespace": "/api/v1",
  "policy": "Existing operations, required request bodies, response statuses and auth may not be removed or weakened without approved breaking-change exception. Optional additions permitted.",
  "operations": {
    "/api/v1/auth/register": {
      "post": {
        "statuses": [
          "201"
        ],
        "request": true
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "statuses": [
          "200"
        ],
        "request": true
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "statuses": [
          "200"
        ]
      }
    },
    "/api/v1/tasks": {
      "get": {
        "statuses": [
          "200"
        ],
        "auth": true
      },
      "post": {
        "statuses": [
          "201"
        ],
        "request": true,
        "auth": true
      }
    },
    "/api/v1/tasks/{task_id}": {
      "patch": {
        "statuses": [
          "200"
        ],
        "request": true,
        "auth": true
      }
    },
    "/api/v1/notifications/preferences": {
      "get": {
        "statuses": [
          "200"
        ],
        "auth": true
      }
    },
    "/api/v1/auth/reminder-lease": {
      "put": {
        "statuses": [
          "200"
        ],
        "request": true,
        "auth": true
      },
      "delete": {
        "statuses": [
          "204"
        ],
        "request": true,
        "auth": true
      }
    },
    "/api/v1/auth/reminder-lease/{session_id}": {
      "get": {
        "statuses": [
          "200"
        ]
      }
    }
  }
}
