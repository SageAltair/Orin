APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+psycopg://orin:change-me-locally@db:5432/orin
CORS_ORIGINS=http://localhost:5173
# Generate a private 32-byte key with: openssl rand -hex 32
AUTH_SECRET_KEY=
AUTH_REFRESH_COOKIE_SECURE=false
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=30
# Optional AI interpretation. Leave AI_PROVIDER empty to run without AI.
AI_PROVIDER=
AI_MODEL=
OPENAI_API_KEY=
MISTRAL_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
QWEN_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
# Optional GitHub App OAuth. Configure the app with read-only Metadata, Issues,
# and Pull requests permissions. Generate an encryption key with
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# For rotation, set newest key first, then previous keys comma-separated; remove old keys after rotation.
INTEGRATION_ENCRYPTION_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_CALLBACK_URL=http://localhost:8100/api/v1/integrations/github/callback
WEB_APP_URL=http://localhost:5173
POSTGRES_DB=orin
POSTGRES_USER=orin
POSTGRES_PASSWORD=change-me-locally
VITE_API_BASE_URL=http://localhost:8100
